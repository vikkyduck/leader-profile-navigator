# Скопируйте в .env и подставьте значения своего проекта Supabase.
# Ключ PUBLISHABLE (anon) — публичный по замыслу: он попадает в JS-бандл
# и виден в браузере. Доступ к данным ограничивается политиками RLS,
# а не секретностью этого ключа. Service-role ключ здесь не нужен.

VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-id>
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-key>
